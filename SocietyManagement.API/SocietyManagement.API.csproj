<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SocietyManagement.API</RootNamespace>
    <AssemblyName>SocietyManagement.API</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UserSecretsId>society-management-api-secrets</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocietyManagement.Application\SocietyManagement.Application.csproj" />
    <ProjectReference Include="..\SocietyManagement.Infrastructure\SocietyManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\SocietyManagement.Shared\SocietyManagement.Shared.csproj" />
  </ItemGroup>

  <!-- Tesseract OCR's English trained data — DependencyInjection.cs checks for this
       folder next to the running app to decide whether to use the real OCR service
       or fall back to the stub. See TesseractVehicleOcrService.cs. -->
  <ItemGroup>
    <None Include="tessdata\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
