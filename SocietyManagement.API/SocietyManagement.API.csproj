<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SocietyManagement.API</RootNamespace>
    <AssemblyName>SocietyManagement.API</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UserSecretsId>society-management-api-secrets</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocietyManagement.Application\SocietyManagement.Application.csproj" />
    <ProjectReference Include="..\SocietyManagement.Infrastructure\SocietyManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\SocietyManagement.Shared\SocietyManagement.Shared.csproj" />
  </ItemGroup>

  <!-- Microsoft.EntityFrameworkCore.Design's IncludeAssets above deliberately
       keeps "build" (needed locally for `dotnet ef migrations add`), but that
       drags its design-time-only build-host folders into the publish output
       too — dozens of MB that are never touched at runtime. Confirmed present
       (and confirmed dead weight) on the live App Service deployment, which
       is on a disk-quota-constrained tier where every MB matters. -->
  <Target Name="TrimEfDesignTimeBuildHosts" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)BuildHost-net472" Condition="Exists('$(PublishDir)BuildHost-net472')" />
    <RemoveDir Directories="$(PublishDir)BuildHost-netcore" Condition="Exists('$(PublishDir)BuildHost-netcore')" />
  </Target>

</Project>
