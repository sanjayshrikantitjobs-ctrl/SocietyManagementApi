  "WhatsApp": {
    "AccessToken": "",
    "PhoneNumberId": "",
    "ApiVersion": "v21.0",
    "DefaultCountryCode": "91",
    "TextTemplateName": "hello_world",
    "TextTemplateLanguage": "en_US",
    "DocumentTemplateName": "",
    "DocumentTemplateLanguage": "en_US",
    "ImageTemplateName": "",
    "ImageTemplateLanguage": "en_US"
  },
  "App": {
    // Absolute base URL of this deployed API (no trailing slash) — used to build
    // links embedded in outbound messages, e.g. the WhatsApp visitor-approval
    // link, which must work with no login. Leave blank to skip sending those
    // links rather than send a broken one.
    "PublicBaseUrl": ""
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG",
    "Issuer": "SocietyManagement.API",
    "Audience": "SocietyManagement.Web"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/auth/forgot-password",
        "Period": "5m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/auth/verify-otp",
        "Period": "5m",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://societymanagement-web.sanjay-shrikant-it-jobs.workers.dev"
  ]
