<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:auth="clr-namespace:SocietyManagement.Mobile.Features.Auth"
             x:Class="SocietyManagement.Mobile.Features.Auth.ChangePasswordPage"
             x:DataType="auth:ChangePasswordViewModel"
             Title="Change Password">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="420" HorizontalOptions="Center">

            <Label Text="Current Password" FontSize="13" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding CurrentPassword}" IsPassword="True" Placeholder="Current password" />

            <Label Text="New Password" FontSize="13" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="New password" />

            <Label Text="Confirm New Password" FontSize="13" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Confirm new password" />

            <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding SuccessMessage}" TextColor="#15803D" FontSize="13"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Button Text="Change Password" Command="{Binding SubmitCommand}" HeightRequest="48" Margin="0,8,0,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
