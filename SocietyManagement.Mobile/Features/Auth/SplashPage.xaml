<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocietyManagement.Mobile.Features.Auth.SplashPage"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource OffBlack}}">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="24">
        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="16,12">
            <Image Source="app_logo_full.png" HeightRequest="70" Aspect="AspectFit" />
        </Border>
        <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
    </VerticalStackLayout>

</ContentPage>
