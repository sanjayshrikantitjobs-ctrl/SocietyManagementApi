<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:facilities="clr-namespace:SocietyManagement.Mobile.Features.Facilities"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Facilities.FacilityDetailPage"
             x:DataType="facilities:FacilityDetailViewModel"
             Title="Facility">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding Facility, Converter={StaticResource IsNotNullConverter}}">
                <Label Text="{Binding Facility.Name}" FontSize="20" FontAttributes="Bold" />
                <Label Style="{StaticResource Muted}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Facility.Type, Converter={StaticResource PascalCaseToWordsConverter}}" />
                            <Span Text=" &#183; Capacity " />
                            <Span Text="{Binding Facility.Capacity}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label FontAttributes="Bold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Facility.PricePerUnit, StringFormat='₹{0:0.00}'}" />
                            <Span Text=" / " />
                            <Span Text="{Binding Facility.PricingType, Converter={StaticResource PascalCaseToWordsConverter}}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{Binding Facility.Description}" IsVisible="{Binding Facility.Description, Converter={StaticResource StringToBoolConverter}}" />

                <Label Text="📅 Check availability for" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                <Border Style="{StaticResource FieldFrame}"><DatePicker Date="{Binding SelectedDate}" /></Border>

                <Label Text="No bookings yet on this date — fully available." Style="{StaticResource Muted}"
                       IsVisible="{Binding Slots.Count, Converter={StaticResource EqualsConverter}, ConverterParameter=0}" />
                <CollectionView ItemsSource="{Binding Slots}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="gen:FacilitySlotDto">
                            <Border Style="{StaticResource RowCard}" Margin="0,4">
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding StartTime}" />
                                            <Span Text=" - " />
                                            <Span Text="{Binding EndTime}" />
                                            <Span Text=" &#183; " />
                                            <Span Text="{Binding Status, Converter={StaticResource PascalCaseToWordsConverter}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Book This Facility" Command="{Binding BookCommand}" Margin="0,12,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
