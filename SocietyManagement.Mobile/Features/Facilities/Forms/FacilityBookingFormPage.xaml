<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Facilities.Forms"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Facilities.Forms.FacilityBookingFormPage"
             x:DataType="forms:FacilityBookingFormViewModel"
             Title="Book Facility">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="{Binding Facility.Name}" FontSize="18" FontAttributes="Bold" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Flat" IsVisible="{Binding Flats.Count, Converter={StaticResource CountToBoolConverter}}" />
                    <Border Style="{StaticResource FieldFrame}" IsVisible="{Binding Flats.Count, Converter={StaticResource CountToBoolConverter}}">
                        <Picker ItemsSource="{Binding Flats}" SelectedItem="{Binding SelectedFlat}">
                            <Picker.ItemDisplayBinding>
                                <Binding Path="FlatNumber" x:DataType="gen:FlatDto" />
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Date" />
                    <Border Style="{StaticResource FieldFrame}"><DatePicker Date="{Binding BookingDate}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Start Time" />
                    <Border Style="{StaticResource FieldFrame}"><TimePicker Time="{Binding StartTime}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="End Time" />
                    <Border Style="{StaticResource FieldFrame}"><TimePicker Time="{Binding EndTime}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Purpose (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Purpose}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Guest Count" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding GuestCount}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Notes (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Editor Text="{Binding Notes}" AutoSize="TextChanges" /></Border>

                    <VerticalStackLayout IsVisible="{Binding Facility, Converter={StaticResource IsNotNullConverter}}" Spacing="2">
                        <Label FontSize="12" Style="{StaticResource Muted}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Rate: " />
                                    <Span Text="{Binding Facility.PricePerUnit, StringFormat='₹{0:0.00}'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="12" Style="{StaticResource Muted}" Text="Final total is calculated and confirmed after you submit." />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Book" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
