<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fest="clr-namespace:SocietyManagement.Mobile.Features.Festivals"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Festivals.BudgetRevisionsPage"
             x:DataType="fest:BudgetRevisionsViewModel"
             Title="History">

    <Grid RowDefinitions="Auto,*">
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Revisions}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" VerticalOptions="Center">
                    <Label Style="{StaticResource Muted}" Text="No changes recorded yet." HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="gen:FestivalBudgetRevisionDto">
                    <Border Style="{StaticResource RowCard}" Margin="14,7">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy h:mm tt}'}" Style="{StaticResource Muted}" />
                            <Label FontSize="13">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Estimated: " />
                                        <Span Text="{Binding PreviousEstimatedAmount, StringFormat='₹{0:N0}'}" />
                                        <Span Text=" → " />
                                        <Span Text="{Binding NewEstimatedAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Approved: " />
                                        <Span Text="{Binding PreviousApprovedAmount, StringFormat='₹{0:N0}'}" />
                                        <Span Text=" → " />
                                        <Span Text="{Binding NewApprovedAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding Reason}" Style="{StaticResource Muted}"
                                   IsVisible="{Binding Reason, Converter={StaticResource StringToBoolConverter}}" />
                            <Label Text="{Binding CreatedBy, StringFormat='by {0}'}" FontSize="11" TextColor="{StaticResource Gray400}"
                                   IsVisible="{Binding CreatedBy, Converter={StaticResource StringToBoolConverter}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
