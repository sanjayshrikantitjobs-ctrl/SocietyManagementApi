<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fest="clr-namespace:SocietyManagement.Mobile.Features.Festivals"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="SocietyManagement.Mobile.Features.Festivals.FestivalDetailPage"
             x:DataType="fest:FestivalDetailViewModel"
             x:Name="Root"
             Title="{Binding Festival.Name}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header: status + menu -->
        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,0" Spacing="10">
            <HorizontalStackLayout Spacing="10">
                <Border Style="{StaticResource chipInfo}">
                    <Label Text="{Binding Festival.Status}" Style="{StaticResource chipTextInfo}" />
                </Border>
                <Border Style="{StaticResource chipBase}" BackgroundColor="{StaticResource PurpleLight}"
                        IsVisible="{Binding Festival.ContributionPoolFestivalName, Converter={StaticResource StringToBoolConverter}}">
                    <Label Text="{Binding Festival.ContributionPoolFestivalName, StringFormat='Child of {0}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                </Border>
                <Button Text="Status ▾" Style="{StaticResource ChipButton}" Command="{Binding ToggleStatusMenuCommand}" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsStatusMenuOpen}" Padding="6">
                <VerticalStackLayout Spacing="2">
                    <Button Text="Mark Planning" Style="{StaticResource TextButton}" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Start" Command="{Binding SetStatusCommand}" CommandParameter="{x:Static gen:FestivalStatus.Planning}" />
                    <Button Text="Mark Ongoing" Style="{StaticResource TextButton}" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Start" Command="{Binding SetStatusCommand}" CommandParameter="{x:Static gen:FestivalStatus.Ongoing}" />
                    <Button Text="Close Festival (Completed)" Style="{StaticResource TextButton}" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Start" Command="{Binding SetStatusCommand}" CommandParameter="{x:Static gen:FestivalStatus.Completed}" />
                    <Button Text="Delete" Style="{StaticResource TextButton}" TextColor="{StaticResource Danger}" HorizontalOptions="Start" Command="{Binding DeleteCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Tab bar -->
        <ScrollView Grid.Row="1" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="4" Padding="10,10,10,4">
                <Button Text="Dashboard" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Dashboard">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Dashboard">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Child Festivals &amp; Events" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="ChildFestivals" IsVisible="{Binding ShowChildFestivalsTab}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="ChildFestivals">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Contribution" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Contribution" IsVisible="{Binding ShowContributionTab}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Contribution">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Budget" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Budget" IsVisible="{Binding ShowStandardTabs}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Budget">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Sponsors" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Sponsors" IsVisible="{Binding ShowStandardTabs}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Sponsors">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Expenses" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Expenses" IsVisible="{Binding ShowStandardTabs}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Expenses">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Vendors" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Vendors" IsVisible="{Binding ShowStandardTabs}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Vendors">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Volunteers" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Volunteers" IsVisible="{Binding ShowStandardTabs}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Volunteers">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Tasks" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Tasks" IsVisible="{Binding ShowStandardTabs}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Tasks">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="🎁 Distributions" Style="{StaticResource segmentTab}" Command="{Binding SelectTabCommand}" CommandParameter="Distributions" IsVisible="{Binding ShowStandardTabs}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Distributions">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </ScrollView>

        <Label Grid.Row="2" Style="{StaticResource ErrorText}" Margin="16,0" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <!-- Dashboard panel -->
        <ScrollView Grid.Row="4" IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Dashboard}">
            <VerticalStackLayout Padding="16" Spacing="14">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12"
                      IsVisible="{Binding Kpis, Converter={StaticResource IsNotNullConverter}}">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Budget" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Kpis.Budget, StringFormat='₹{0:N0}'}" Style="{StaticResource kpiValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Collected" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Kpis.Collected, StringFormat='₹{0:N0}'}" Style="{StaticResource kpiValue}" TextColor="{StaticResource Success}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Spent" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Kpis.Spent, StringFormat='₹{0:N0}'}" Style="{StaticResource kpiValue}" TextColor="{StaticResource Warning}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Remaining" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Kpis.Remaining, StringFormat='₹{0:N0}'}" Style="{StaticResource kpiValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Sponsors" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Kpis.SponsorsCount}" Style="{StaticResource kpiValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Pending Expenses" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Kpis.PendingExpensesCount}" Style="{StaticResource kpiValue}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" IsVisible="{Binding CollectionProgressChart, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Collection Progress" Style="{StaticResource SectionTitle}" FontSize="14" />
                        <microcharts:ChartView Chart="{Binding CollectionProgressChart}" HeightRequest="180" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding BudgetVsActualChart, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Budget vs Actual (Approved / Actual)" Style="{StaticResource SectionTitle}" FontSize="14" />
                        <microcharts:ChartView Chart="{Binding BudgetVsActualChart}" HeightRequest="200" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding ExpenseByCategoryChart, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Expense by Category" Style="{StaticResource SectionTitle}" FontSize="14" />
                        <microcharts:ChartView Chart="{Binding ExpenseByCategoryChart}" HeightRequest="180" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding SponsorContributionChart, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Sponsor Contribution (Promised / Received)" Style="{StaticResource SectionTitle}" FontSize="14" />
                        <microcharts:ChartView Chart="{Binding SponsorContributionChart}" HeightRequest="200" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Child Festivals panel -->
        <VerticalStackLayout Grid.Row="4" Padding="16" Spacing="10"
                             IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=ChildFestivals}">
            <CollectionView ItemsSource="{Binding ChildFestivals}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No child festivals yet. Add Ganpati, Navratri, or any other festival that should draw from this shared pool."
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:PoolChildSummaryDto">
                        <Border Style="{StaticResource RowCard}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenChildFestivalCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource Info}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Status}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Budget, StringFormat='₹{0:N0} budget'}" HorizontalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Spent, StringFormat='₹{0:N0} spent'}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Contribution panel -->
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto,Auto,*"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Contribution}">

            <Grid Grid.Row="0" Padding="16,10" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10"
                  IsVisible="{Binding ContributionKpis, Converter={StaticResource IsNotNullConverter}}">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Target (All Flats)" Style="{StaticResource kpiLabel}" FontSize="11" />
                        <Label Text="{Binding ContributionKpis.TotalTargetAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Collected" Style="{StaticResource kpiLabel}" FontSize="11" />
                        <Label Text="{Binding ContributionKpis.TotalPaidAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Outstanding" Style="{StaticResource kpiLabel}" FontSize="11" />
                        <Label Text="{Binding ContributionKpis.TotalOutstandingAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Flats Fully Paid" Style="{StaticResource kpiLabel}" FontSize="11" />
                        <Label FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ContributionKpis.FlatsPaidCount}" />
                                    <Span Text=" / " />
                                    <Span Text="{Binding ContributionKpis.TotalFlats}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Padding="16,4" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="By Flat" Style="{StaticResource segmentTab}"
                        Command="{Binding SwitchContributionViewCommand}" CommandParameter="Flats">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ContributionView}" Value="Flats">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="All Contributions" Style="{StaticResource segmentTab}"
                        Command="{Binding SwitchContributionViewCommand}" CommandParameter="All">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ContributionView}" Value="All">
                            <Setter Property="Style" Value="{StaticResource segmentTabActive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Padding="16,4" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Style="{StaticResource OutlineButton}" Text="Set Target for All Flats" FontSize="12" Command="{Binding SetTargetForAllCommand}" />
                <Button Grid.Column="1" Text="Record Contribution" FontSize="12" Command="{Binding RecordContributionCommand}" />
            </Grid>

            <Grid Grid.Row="3" Padding="8,4" ColumnDefinitions="2*,2*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource FieldFrame}">
                    <SearchBar Placeholder="Search flat / donor..." Text="{Binding ContributionSearch}" SearchCommand="{Binding LoadContributionCommand}" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FieldFrame}"
                        IsVisible="{Binding ContributionView, Converter={StaticResource EqualsConverter}, ConverterParameter=Flats}">
                    <Picker ItemsSource="{Binding ContributionStatusOptions}" ItemDisplayBinding="{Binding Label}"
                            SelectedItem="{Binding SelectedContributionStatus}" FontSize="13" />
                </Border>
            </Grid>

            <CollectionView Grid.Row="4" ItemsSource="{Binding FlatContributions}"
                            IsVisible="{Binding ContributionView, Converter={StaticResource EqualsConverter}, ConverterParameter=Flats}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No flats found." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FlatContributionDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenFlatDetailCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding FlatNumber, StringFormat='Flat {0}'}" FontAttributes="Bold" />
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource chipInfo}" HorizontalOptions="Start">
                                    <Label Text="{Binding Status}" Style="{StaticResource chipTextInfo}" />
                                </Border>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding OutstandingAmount, StringFormat='₹{0:N0} due'}" FontAttributes="Bold" HorizontalOptions="End" TextColor="{StaticResource Danger}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PaidAmount, StringFormat='₹{0:N0} paid'}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView Grid.Row="4" ItemsSource="{Binding AllContributions}"
                            IsVisible="{Binding ContributionView, Converter={StaticResource EqualsConverter}, ConverterParameter=All}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No contributions recorded yet." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FestivalContributionDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowContributionActionsCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding MemberName}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding ReceiptNumber}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" HorizontalOptions="End" TextColor="{StaticResource Success}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PaymentDate, StringFormat='{0:MMM d, yyyy}'}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Budget panel -->
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Budget}">
            <Grid Grid.Row="0" Padding="16,10" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                    <VerticalStackLayout>
                        <Label Text="Estimated" Style="{StaticResource kpiLabel}" FontSize="11" />
                        <Label Text="{Binding TotalEstimated, StringFormat='₹{0:N0}'}" FontAttributes="Bold" FontSize="14" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
                    <VerticalStackLayout>
                        <Label Text="Approved" Style="{StaticResource kpiLabel}" FontSize="11" />
                        <Label Text="{Binding TotalApproved, StringFormat='₹{0:N0}'}" FontAttributes="Bold" FontSize="14" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                    <VerticalStackLayout>
                        <Label Text="Actual" Style="{StaticResource kpiLabel}" FontSize="11" />
                        <Label Text="{Binding TotalActual, StringFormat='₹{0:N0}'}" FontAttributes="Bold" FontSize="14" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Button Grid.Row="1" Margin="16,0" Text="Add Category" Command="{Binding AddBudgetCategoryCommand}" HorizontalOptions="Start" FontSize="12" />
            <CollectionView Grid.Row="2" ItemsSource="{Binding BudgetCategories}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No budget categories yet." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FestivalBudgetCategoryDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowBudgetCategoryActionsCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Category}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Remaining, StringFormat='₹{0:N0} remaining'}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding ApprovedAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding ActualAmount, StringFormat='₹{0:N0} spent'}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Sponsors panel -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Sponsors}">
            <Button Grid.Row="0" Margin="16,10" Text="Add Sponsor" Command="{Binding AddSponsorCommand}" HorizontalOptions="Start" FontSize="12" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Sponsors}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No sponsors yet." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FestivalSponsorDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowSponsorActionsCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding CompanyName}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding ContactPerson}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding PromisedAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PendingAmount, StringFormat='₹{0:N0} pending'}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Expenses panel -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Expenses}">
            <Button Grid.Row="0" Margin="16,10" Text="Record Expense" Command="{Binding AddExpenseCommand}" HorizontalOptions="Start" FontSize="12" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Expenses}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No expenses recorded yet." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FestivalExpenseDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowExpenseActionsCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Category}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding VendorName}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding RejectionReason}" FontSize="11" TextColor="{StaticResource Danger}"
                                       IsVisible="{Binding RejectionReason, Converter={StaticResource StringToBoolConverter}}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" HorizontalOptions="End" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource chipInfo}" HorizontalOptions="End">
                                    <Label Text="{Binding ApprovalStatus}" Style="{StaticResource chipTextInfo}" />
                                </Border>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ExpenseDate, StringFormat='{0:MMM d}'}" Style="{StaticResource Muted}" FontSize="11" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Vendors panel -->
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Vendors}">
            <Border Grid.Row="0" Style="{StaticResource FieldFrame}" Margin="8,4">
                <SearchBar Placeholder="Search vendors" Text="{Binding VendorSearch}" SearchCommand="{Binding LoadVendorsCommand}" />
            </Border>
            <Button Grid.Row="1" Margin="16,0,16,10" Text="Add Vendor" Command="{Binding AddVendorCommand}" HorizontalOptions="Start" FontSize="12" />
            <CollectionView Grid.Row="2" ItemsSource="{Binding Vendors}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No vendors in the directory yet." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FestivalVendorDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowVendorActionsCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Category}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Rating, StringFormat='★ {0}/5'}" HorizontalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding OutstandingAmount, StringFormat='₹{0:N0} due'}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Volunteers panel -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Volunteers}">
            <Button Grid.Row="0" Margin="16,10" Text="Add Volunteer" Command="{Binding AddVolunteerCommand}" HorizontalOptions="Start" FontSize="12" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Volunteers}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No volunteers added yet." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FestivalVolunteerDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowVolunteerActionsCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Phone}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Email}" HorizontalOptions="End" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Tasks panel -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Tasks}">
            <Button Grid.Row="0" Margin="16,10" Text="Add Task" Command="{Binding AddTaskCommand}" HorizontalOptions="Start" FontSize="12" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Tasks}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource Muted}" Text="No tasks added yet." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FestivalTaskDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowTaskActionsCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding AssignedVolunteerName, StringFormat='Assigned: {0}'}" Style="{StaticResource Muted}" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource chipInfo}" HorizontalOptions="End">
                                    <Label Text="{Binding Status}" Style="{StaticResource chipTextInfo}" />
                                </Border>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DueDate, StringFormat='Due {0:MMM d}'}" Style="{StaticResource Muted}" HorizontalOptions="End"
                                       IsVisible="{Binding DueDate, Converter={StaticResource IsNotNullConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Distributions panel -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*"
              IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Distributions}">
            <Button Grid.Row="0" Margin="16,10" Text="Add Distribution" Command="{Binding AddDistributionCommand}" HorizontalOptions="Start" FontSize="12" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding Distributions}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32" VerticalOptions="Center">
                        <Label Style="{StaticResource Muted}" Text="No distributions yet. Set up a giveaway — Kurta, T-shirt, gift, prasad, coupon — for flats that qualify."
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="gen:FestivalDistributionDto">
                        <Border Style="{StaticResource RowCard}" Margin="14,7">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenDistributionCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding ItemName, StringFormat='🎁 {0}'}" FontAttributes="Bold" FontSize="15" />
                                    <Border Grid.Column="1" Style="{StaticResource chipInfo}" HorizontalOptions="End">
                                        <Label Text="{Binding Status}" Style="{StaticResource chipTextInfo}" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12"
                                       IsVisible="{Binding Description, Converter={StaticResource StringToBoolConverter}}" />
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding EligibleFlatsCount}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                                        <Label Text="Eligible Flats" Style="{StaticResource kpiLabel}" FontSize="9" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding TotalQuantity}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                                        <Label Text="Total Qty" Style="{StaticResource kpiLabel}" FontSize="9" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="{Binding PendingCount}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" TextColor="{StaticResource Warning}" />
                                        <Label Text="Pending" Style="{StaticResource kpiLabel}" FontSize="9" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="3">
                                        <Label Text="{Binding DistributedCount}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" TextColor="{StaticResource Success}" />
                                        <Label Text="Distributed" Style="{StaticResource kpiLabel}" FontSize="9" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>

</ContentPage>
