<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fest="clr-namespace:SocietyManagement.Mobile.Features.Festivals"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Festivals.FestivalsListPage"
             x:DataType="fest:FestivalsListViewModel"
             Title="Festivals">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Shared card look for both the Primary and Child sections below —
                 a banner (real image if the festival has one, a soft tinted
                 placeholder with a celebration glyph otherwise) with a
                 floating status pill, then name/dates and a 3-up budget row. -->
            <DataTemplate x:Key="FestivalCardTemplate" x:DataType="gen:FestivalDto">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="0">
                        <Grid HeightRequest="118">
                            <BoxView Color="{StaticResource PrimaryLight}" />
                            <Image Source="{Binding BannerImageUrl, Converter={StaticResource AssetUrlConverter}}" Aspect="AspectFill"
                                   IsVisible="{Binding BannerImageUrl, Converter={StaticResource StringToBoolConverter}}" />
                            <Label Text="🎉" FontSize="42" Opacity="0.55" HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding BannerImageUrl, Converter={StaticResource StringIsNullOrEmptyConverter}}" />
                            <Border BackgroundColor="White" Opacity="0.94" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    Padding="10,4" HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,10,0">
                                <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryDarkText}" />
                            </Border>
                        </Grid>
                        <VerticalStackLayout Padding="16,14,16,16" Spacing="10">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="📅" FontSize="12" VerticalOptions="Center" />
                                <Label Style="{StaticResource Muted}" FontSize="12" VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding StartDate, StringFormat='{0:MMM d}'}" />
                                            <Span Text=" – " />
                                            <Span Text="{Binding EndDate, StringFormat='{0:MMM d, yyyy}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </HorizontalStackLayout>
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}" />
                            <Grid ColumnDefinitions="*,*,*">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Budget" Style="{StaticResource kpiLabel}" FontSize="9" />
                                    <Label Text="{Binding TotalBudget, StringFormat='₹{0:N0}'}" FontAttributes="Bold" FontSize="13" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Collected" Style="{StaticResource kpiLabel}" FontSize="9" />
                                    <Label Text="{Binding Collected, StringFormat='₹{0:N0}'}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource Success}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="1">
                                    <Label Text="Spent" Style="{StaticResource kpiLabel}" FontSize="9" />
                                    <Label Text="{Binding Spent, StringFormat='₹{0:N0}'}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource Warning}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16,14" Spacing="4">

                <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                <VerticalStackLayout Padding="32,40" Spacing="6" HorizontalOptions="Center"
                                     IsVisible="{Binding Festivals.Count, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                    <Label Text="🎊" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="No festivals yet" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="Create your first festival to start tracking its budget, contributions and expenses."
                           Style="{StaticResource Muted}" HorizontalTextAlignment="Center" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Primary Festivals & Events -->
                <HorizontalStackLayout Spacing="8" Margin="2,8,0,10"
                                       IsVisible="{Binding PrimaryFestivals.Count, Converter={StaticResource CountToBoolConverter}}">
                    <BoxView WidthRequest="4" HeightRequest="18" Color="{StaticResource Primary}" CornerRadius="2" />
                    <Label Text="🎪 Primary Festivals &amp; Events" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <CollectionView ItemsSource="{Binding PrimaryFestivals}" ItemTemplate="{StaticResource FestivalCardTemplate}"
                                SelectionMode="Single" SelectionChanged="OnFestivalSelected" />

                <!-- Child Festivals & Events -->
                <HorizontalStackLayout Spacing="8" Margin="2,24,0,10" IsVisible="{Binding HasChildFestivals}">
                    <BoxView WidthRequest="4" HeightRequest="18" Color="{StaticResource Purple}" CornerRadius="2" />
                    <Label Text="🎈 Child Festivals &amp; Events" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" TextColor="{StaticResource Purple}" />
                </HorizontalStackLayout>
                <CollectionView ItemsSource="{Binding ChildFestivals}" ItemTemplate="{StaticResource FestivalCardTemplate}"
                                SelectionMode="Single" SelectionChanged="OnFestivalSelected"
                                IsVisible="{Binding HasChildFestivals}" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
