<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fest="clr-namespace:SocietyManagement.Mobile.Features.Festivals"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Festivals.FestivalsListPage"
             x:DataType="fest:FestivalsListViewModel"
             Title="Festivals">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Festivals}" SelectionMode="Single" SelectionChanged="OnFestivalSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" VerticalOptions="Center" Spacing="8">
                    <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" HorizontalOptions="Center"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Style="{StaticResource Muted}" Text="No festivals yet." HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="gen:FestivalDto">
                    <Border Style="{StaticResource RowCard}" Margin="14,7">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Year}" Style="{StaticResource Muted}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource chipInfo}" VerticalOptions="Center">
                                <Label Text="{Binding Status}" Style="{StaticResource chipTextInfo}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
