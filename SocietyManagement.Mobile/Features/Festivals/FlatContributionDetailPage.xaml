<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fest="clr-namespace:SocietyManagement.Mobile.Features.Festivals"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Festivals.FlatContributionDetailPage"
             x:DataType="fest:FlatContributionDetailViewModel"
             x:Name="Root"
             Title="Flat Contribution">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Grid.Row="0" Style="{StaticResource ErrorText}" Margin="16,4" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

        <Grid Grid.Row="1" Padding="16,8" ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding Summary, Converter={StaticResource IsNotNullConverter}}">
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <VerticalStackLayout>
                    <Label Text="Target" Style="{StaticResource kpiLabel}" FontSize="11" />
                    <Label Text="{Binding Summary.TargetAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
                <VerticalStackLayout>
                    <Label Text="Paid" Style="{StaticResource kpiLabel}" FontSize="11" />
                    <Label Text="{Binding Summary.PaidAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <VerticalStackLayout>
                    <Label Text="Outstanding" Style="{StaticResource kpiLabel}" FontSize="11" />
                    <Label Text="{Binding Summary.OutstandingAmount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <HorizontalStackLayout Grid.Row="2" Padding="16,4" Spacing="8">
            <Button Style="{StaticResource OutlineButton}" Text="Edit Target" Command="{Binding EditTargetCommand}" FontSize="12" />
            <Button Text="Add Contribution" Command="{Binding AddContributionCommand}" FontSize="12" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Contributions}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" VerticalOptions="Center">
                    <Label Style="{StaticResource Muted}" Text="No contributions recorded yet for this flat." HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="gen:FestivalContributionDto">
                    <Border Style="{StaticResource RowCard}" Margin="14,7">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowContributionActionsCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding MemberName}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding ReceiptNumber}" Style="{StaticResource Muted}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}" FontAttributes="Bold" HorizontalOptions="End" TextColor="{StaticResource Success}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PaymentDate, StringFormat='{0:MMM d, yyyy}'}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
