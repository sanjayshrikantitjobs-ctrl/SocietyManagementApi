<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.BudgetCategoryFormPage"
             x:DataType="forms:BudgetCategoryFormViewModel"
             Title="Budget Category">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Category" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding CategoryOptions}" ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedCategory}" IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolConverter}}" />
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding ShowCustomName}" Spacing="14">
                        <Label Style="{StaticResource FieldLabel}" Text="Custom Category Name" />
                        <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding CustomCategoryName}" /></Border>
                    </VerticalStackLayout>

                    <Label Style="{StaticResource FieldLabel}" Text="Estimated Amount" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding EstimatedAmount}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Approved Amount" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding ApprovedAmount}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Notes (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Editor Text="{Binding Notes}" AutoSize="TextChanges" /></Border>

                    <VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="14">
                        <Label Style="{StaticResource FieldLabel}" Text="Reason for Change (optional)" />
                        <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Reason}" /></Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
