<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.ContributionFormPage"
             x:DataType="forms:ContributionFormViewModel"
             Title="Contribution">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Style="{StaticResource SectionTitle}" Text="{Binding LockedFlatNumber, StringFormat='Flat {0}'}"
                   IsVisible="{Binding ShowLockedFlat}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout IsVisible="{Binding ShowFlatPicker}" Spacing="14">
                        <Label Style="{StaticResource FieldLabel}" Text="Flat" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Picker ItemsSource="{Binding FlatOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedFlat}" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Style="{StaticResource FieldLabel}" Text="Donor Name" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding MemberName}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Amount" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Amount}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Payment Mode" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding PaymentModeOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedPaymentMode}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Payment Date" />
                    <Border Style="{StaticResource FieldFrame}"><DatePicker Date="{Binding PaymentDate}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Transaction Reference (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding TransactionId}" /></Border>

                    <VerticalStackLayout IsVisible="{Binding ShowWhatsApp}" Spacing="14">
                        <Label Style="{StaticResource FieldLabel}" Text="WhatsApp Number (optional — defaults to flat's number on file)" />
                        <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding WhatsAppNumber}" Keyboard="Telephone" /></Border>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding IsAnonymous}" />
                        <Label Text="Keep donor anonymous on public displays" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
