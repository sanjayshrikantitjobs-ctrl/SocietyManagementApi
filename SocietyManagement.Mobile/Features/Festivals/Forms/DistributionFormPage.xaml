<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.DistributionFormPage"
             x:DataType="forms:DistributionFormViewModel"
             Title="Distribution">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Item Name (e.g. Kurta, T-shirt, Prasad)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding ItemName}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Description (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Editor Text="{Binding Description}" AutoSize="TextChanges" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Quantity per Eligible Flat" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding QuantityPerFlat}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Eligibility" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding EligibilityOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedEligibility}" />
                    </Border>

                    <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowMinContribution}">
                        <Label Style="{StaticResource FieldLabel}" Text="Minimum Contribution Amount (₹)" />
                        <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding EligibilityMinContribution}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowVariantLabels}">
                        <Label Style="{StaticResource FieldLabel}" Text="Size/Variant Options (optional)" />
                        <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding VariantLabels}" Placeholder="L, XL, XXL, XXXL, 4XL" /></Border>
                        <Label Style="{StaticResource Muted}" Text="Comma-separated. Leave blank if this item has no size/variant choice." />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
