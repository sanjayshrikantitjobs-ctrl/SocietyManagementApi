<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.ExpenseFormPage"
             x:DataType="forms:ExpenseFormViewModel"
             Title="Expense">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Budget Category" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding CategoryOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedCategory}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Vendor (optional)" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding VendorOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedVendor}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Amount" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Amount}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Expense Date" />
                    <Border Style="{StaticResource FieldFrame}"><DatePicker Date="{Binding ExpenseDate}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Payment Method" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding PaymentModeOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedPaymentMode}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Invoice Number (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding InvoiceNumber}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Description (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Editor Text="{Binding Description}" AutoSize="TextChanges" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Bill Image URL (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding BillImageUrl}" /></Border>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
