<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.ExpenseFormPage"
             x:DataType="forms:ExpenseFormViewModel"
             Title="Expense">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="Budget Category" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Picker ItemsSource="{Binding CategoryOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedCategory}" />

            <Label Text="Vendor (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Picker ItemsSource="{Binding VendorOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedVendor}" />

            <Label Text="Amount" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Amount}" Keyboard="Numeric" />

            <Label Text="Expense Date" FontSize="12" TextColor="{StaticResource Gray500}" />
            <DatePicker Date="{Binding ExpenseDate}" />

            <Label Text="Payment Method" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Picker ItemsSource="{Binding PaymentModeOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedPaymentMode}" />

            <Label Text="Invoice Number (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding InvoiceNumber}" />

            <Label Text="Description (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Editor Text="{Binding Description}" AutoSize="TextChanges" />

            <Label Text="Bill Image URL (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding BillImageUrl}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
