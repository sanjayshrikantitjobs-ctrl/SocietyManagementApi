<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.SponsorFormPage"
             x:DataType="forms:SponsorFormViewModel"
             Title="Sponsor">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Company Name" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding CompanyName}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Contact Person (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding ContactPerson}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Phone (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Phone}" Keyboard="Telephone" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Email (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Email}" Keyboard="Email" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Promised Amount" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding PromisedAmount}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Received Amount" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding ReceivedAmount}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Logo URL (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding LogoUrl}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Banner URL (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding BannerUrl}" /></Border>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
