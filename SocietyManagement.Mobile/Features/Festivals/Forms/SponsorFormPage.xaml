<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.SponsorFormPage"
             x:DataType="forms:SponsorFormViewModel"
             Title="Sponsor">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="Company Name" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding CompanyName}" />

            <Label Text="Contact Person (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding ContactPerson}" />

            <Label Text="Phone (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Phone}" Keyboard="Telephone" />

            <Label Text="Email (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Email}" Keyboard="Email" />

            <Label Text="Promised Amount" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding PromisedAmount}" Keyboard="Numeric" />

            <Label Text="Received Amount" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding ReceivedAmount}" Keyboard="Numeric" />

            <Label Text="Logo URL (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding LogoUrl}" />

            <Label Text="Banner URL (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding BannerUrl}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
