<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.TaskFormPage"
             x:DataType="forms:TaskFormViewModel"
             Title="Task">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Title" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Title}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Description (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Editor Text="{Binding Description}" AutoSize="TextChanges" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Assigned To" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding VolunteerOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedVolunteer}" />
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="14">
                        <Label Style="{StaticResource FieldLabel}" Text="Status" />
                        <Border Style="{StaticResource FieldFrame}">
                            <Picker ItemsSource="{Binding StatusOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedStatus}" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="2*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Style="{StaticResource FieldLabel}" Text="Due Date (optional)" />
                            <Border Style="{StaticResource FieldFrame}"><DatePicker Date="{Binding DueDate}" /></Border>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Style="{StaticResource TextButton}" Text="Clear" Command="{Binding ClearDueDateCommand}" VerticalOptions="End" />
                    </Grid>
                    <Label Style="{StaticResource Muted}" Text="No due date set" IsVisible="{Binding HasDueDate, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
