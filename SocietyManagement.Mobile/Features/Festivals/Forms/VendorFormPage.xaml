<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.VendorFormPage"
             x:DataType="forms:VendorFormViewModel"
             Title="Vendor">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Name" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Name}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Category" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding CategoryOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedCategory}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Phone (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Phone}" Keyboard="Telephone" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Email (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Email}" Keyboard="Email" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="GST Number (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding GstNumber}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Address (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Editor Text="{Binding Address}" AutoSize="TextChanges" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Rating (0-5)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Rating}" Keyboard="Numeric" /></Border>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
