<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Festivals.Forms"
             x:Class="SocietyManagement.Mobile.Features.Festivals.Forms.VendorFormPage"
             x:DataType="forms:VendorFormViewModel"
             Title="Vendor">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="Name" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Name}" />

            <Label Text="Category" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Picker ItemsSource="{Binding CategoryOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedCategory}" />

            <Label Text="Phone (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Phone}" Keyboard="Telephone" />

            <Label Text="Email (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Email}" Keyboard="Email" />

            <Label Text="GST Number (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding GstNumber}" />

            <Label Text="Address (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Editor Text="{Binding Address}" AutoSize="TextChanges" />

            <Label Text="Rating (0-5)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Rating}" Keyboard="Numeric" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
