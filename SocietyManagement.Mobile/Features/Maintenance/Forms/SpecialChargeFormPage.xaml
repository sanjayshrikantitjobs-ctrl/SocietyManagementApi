<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Maintenance.Forms"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Maintenance.Forms.SpecialChargeFormPage"
             x:DataType="forms:SpecialChargeFormViewModel"
             x:Name="Root"
             Title="Special Charge">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Style="{StaticResource SectionTitle}" Text="{Binding ExistingFlatNumber, StringFormat='Flat {0}'}"
                   IsVisible="{Binding IsEditMode}" />

            <VerticalStackLayout IsVisible="{Binding IsEditMode, Converter={StaticResource InvertedBoolConverter}}" Spacing="8">
                <Label Style="{StaticResource FieldLabel}" Text="Flat" />
                <Border Style="{StaticResource FieldFrame}"><SearchBar Placeholder="Search flat number..." Text="{Binding FlatSearchText}" /></Border>
                <CollectionView ItemsSource="{Binding FlatSearchResults}" HeightRequest="120"
                                IsVisible="{Binding FlatSearchResults.Count, Converter={StaticResource CountToBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="gen:FlatDto">
                            <Grid Padding="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectFlatCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding FlatNumber}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Charge Name" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding ChargeName}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Amount" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Amount}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Frequency" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding FrequencyOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedFrequency}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Start Date" />
                    <Border Style="{StaticResource FieldFrame}"><DatePicker Date="{Binding StartDate}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="End Date (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><DatePicker Date="{Binding EndDate}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Notes (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Editor Text="{Binding Notes}" AutoSize="TextChanges" /></Border>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
