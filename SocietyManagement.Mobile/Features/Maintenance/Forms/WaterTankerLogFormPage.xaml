<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Maintenance.Forms"
             x:Class="SocietyManagement.Mobile.Features.Maintenance.Forms.WaterTankerLogFormPage"
             x:DataType="forms:WaterTankerLogFormViewModel"
             Title="Tanker Entry">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Date" />
                    <Border Style="{StaticResource FieldFrame}"><DatePicker Date="{Binding Date}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Tanker Provider Name" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding ProviderName}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Vehicle Number" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding VehicleNumber}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Number of Tankers" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding NumberOfTankers}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Price per Tanker (₹)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding PricePerTanker}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Notes (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Notes}" /></Border>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
