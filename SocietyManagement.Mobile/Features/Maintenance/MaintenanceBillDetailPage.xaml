<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maint="clr-namespace:SocietyManagement.Mobile.Features.Maintenance"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Maintenance.MaintenanceBillDetailPage"
             x:DataType="maint:MaintenanceBillDetailViewModel"
             Title="Bill Detail">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Grid.Row="0" Style="{StaticResource ErrorText}" Margin="16,4" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

        <ScrollView Grid.Row="1" IsVisible="{Binding Bill, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource PageTitle}" Text="{Binding Bill.InvoiceNumber}" FontSize="20" />
                    <Border Grid.Column="1" Style="{StaticResource chipInfo}" VerticalOptions="Center">
                        <Label Text="{Binding Bill.Status}" Style="{StaticResource chipTextInfo}" />
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Flat" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Bill.FlatNumber}" Style="{StaticResource kpiValue}" FontSize="16" />
                            <Label Text="{Binding Bill.BuildingName}" Style="{StaticResource Muted}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Owner" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding DisplayOwnerName}" Style="{StaticResource kpiValue}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Bill Month" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Bill.BillMonth, StringFormat='{0:MMMM yyyy}'}" Style="{StaticResource kpiValue}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Due Date" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Bill.DueDate, StringFormat='{0:MMM d, yyyy}'}" Style="{StaticResource kpiValue}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Total" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Bill.TotalAmount, StringFormat='₹{0:N0}'}" Style="{StaticResource kpiValue}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Paid" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Bill.AmountPaid, StringFormat='₹{0:N0}'}" Style="{StaticResource kpiValue}" FontSize="16" TextColor="{StaticResource Success}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="Balance" Style="{StaticResource kpiLabel}" />
                            <Label Text="{Binding Bill.Balance, StringFormat='₹{0:N0}'}" Style="{StaticResource kpiValue}" TextColor="{StaticResource Danger}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                    <Button Text="Download PDF" Style="{StaticResource OutlineButton}" Command="{Binding DownloadPdfCommand}" Margin="0,0,8,8" />
                    <Button Text="Record Payment" Command="{Binding RecordPaymentCommand}" IsVisible="{Binding CanRecordPayment}" Margin="0,0,8,8" />
                    <Button Text="Mark as Unpaid" Style="{StaticResource OutlineButton}" Command="{Binding MarkUnpaidCommand}" IsVisible="{Binding CanMarkUnpaid}" Margin="0,0,8,8" />
                    <Button Text="Resend WhatsApp" Style="{StaticResource OutlineButton}" Command="{Binding ResendWhatsAppCommand}" Margin="0,0,8,8" />
                </FlexLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Bill Items" Style="{StaticResource SectionTitle}" />
                        <CollectionView ItemsSource="{Binding Bill.Items}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="gen:MaintenanceBillItemDto">
                                    <Grid Padding="0,6" ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Description}" />
                                        <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}" HorizontalOptions="End" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Payment History" Style="{StaticResource SectionTitle}" />
                        <CollectionView ItemsSource="{Binding Bill.Payments}">
                            <CollectionView.EmptyView>
                                <Label Style="{StaticResource Muted}" Text="No payments recorded yet." />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="gen:MaintenancePaymentDto">
                                    <Grid Padding="0,6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding PaymentDate, StringFormat='{0:MMM d, yyyy}'}" FontAttributes="Bold" />
                                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding PaymentMode}" Style="{StaticResource Muted}" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}" HorizontalOptions="End" FontAttributes="Bold" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TransactionReference}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Notes, StringFormat='Note: {0}'}"
                                               IsVisible="{Binding Notes, Converter={StaticResource StringToBoolConverter}}"
                                               Style="{StaticResource Muted}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
