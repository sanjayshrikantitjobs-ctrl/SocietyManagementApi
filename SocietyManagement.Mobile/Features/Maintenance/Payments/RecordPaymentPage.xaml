<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pay="clr-namespace:SocietyManagement.Mobile.Features.Maintenance.Payments"
             x:Class="SocietyManagement.Mobile.Features.Maintenance.Payments.RecordPaymentPage"
             x:DataType="pay:RecordPaymentViewModel"
             Title="Record Payment">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding InvoiceNumber, StringFormat='Invoice {0}'}" FontSize="16" FontAttributes="Bold" />

            <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="Amount" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Amount}" Keyboard="Numeric" />

            <Label Text="Payment Date" FontSize="12" TextColor="{StaticResource Gray500}" />
            <DatePicker Date="{Binding PaymentDate}" />

            <Label Text="Payment Mode" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Picker ItemsSource="{Binding PaymentModeOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedPaymentMode}" />

            <Label Text="Transaction Reference (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding TransactionReference}" />

            <Label Text="Notes (optional)" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Editor Text="{Binding Notes}" AutoSize="TextChanges" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
