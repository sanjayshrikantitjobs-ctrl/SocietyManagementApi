<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Residents.Forms"
             x:Class="SocietyManagement.Mobile.Features.Residents.Forms.VehicleFormPage"
             x:DataType="forms:VehicleFormViewModel"
             Title="Vehicle">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Vehicle Type" />
                    <Border Style="{StaticResource FieldFrame}">
                        <Picker ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Registration Number" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding RegistrationNumber}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Make (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Make}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Model (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Model}" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Color (optional)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Color}" /></Border>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
