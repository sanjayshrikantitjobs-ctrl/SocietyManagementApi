<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:soc="clr-namespace:SocietyManagement.Mobile.Features.Societies"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Societies.SocietyStructurePage"
             x:DataType="soc:SocietyStructureViewModel"
             x:Name="Root"
             Title="Society Structure">

    <Grid RowDefinitions="Auto,Auto,*">
        <Button Grid.Row="0" Text="+ Add Building" Margin="16,12,16,4" HorizontalOptions="Start" FontSize="13" Command="{Binding AddBuildingCommand}" />

        <Label Grid.Row="1" Style="{StaticResource ErrorText}" Margin="16,0" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Buildings}">
            <CollectionView.EmptyView>
                <Label Style="{StaticResource Muted}" Text="No buildings yet." HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="soc:BuildingItemViewModel">
                    <Border Style="{StaticResource RowCard}" Margin="14,7">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleBuildingCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding WingCount, StringFormat='{0} wing(s)'}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                            </Grid>

                            <HorizontalStackLayout Spacing="16" IsVisible="{Binding IsExpanded}">
                                <Button Text="+ Add Wing" Style="{StaticResource TextButton}" FontSize="12"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.AddWingCommand}" CommandParameter="{Binding .}" />
                                <Button Text="Delete Building" Style="{StaticResource TextButton}" TextColor="{StaticResource Danger}" FontSize="12"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteBuildingCommand}" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>

                            <ActivityIndicator IsRunning="{Binding IsLoadingWings}" IsVisible="{Binding IsLoadingWings}" HeightRequest="20" />

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExpanded}"
                                                 BindableLayout.ItemsSource="{Binding Wings}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="gen:WingDto">
                                        <Border Style="{StaticResource Card}" Padding="12,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="13" />
                                                <Label Grid.Column="1" Text="{Binding FloorCount, StringFormat='{0} floor(s)'}" Style="{StaticResource Muted}" FontSize="12" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
