<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:staff="clr-namespace:SocietyManagement.Mobile.Features.Staff"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Staff.StaffPage"
             x:DataType="staff:StaffViewModel"
             Title="Staff">

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Style="{StaticResource FieldFrame}" Margin="12,12,12,4">
            <SearchBar Placeholder="Search name or phone..." Text="{Binding Search}" SearchCommand="{Binding LoadCommand}" />
        </Border>

        <Label Grid.Row="1" Style="{StaticResource ErrorText}" Margin="16,0" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Staff}">
            <CollectionView.EmptyView>
                <Label Style="{StaticResource Muted}" Text="No staff members yet." HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="gen:StaffDto">
                    <Border Style="{StaticResource RowCard}" Margin="14,7">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding FirstName}" FontAttributes="Bold" />
                                        <Span Text=" " />
                                        <Span Text="{Binding LastName}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource chipInfo}" HorizontalOptions="End">
                                <Label Text="{Binding Category}" Style="{StaticResource chipTextInfo}" />
                            </Border>
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Phone}" Style="{StaticResource Muted}" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource chipSuccess}" HorizontalOptions="End" IsVisible="{Binding IsActive}">
                                <Label Text="Active" Style="{StaticResource chipTextSuccess}" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource chipDanger}" HorizontalOptions="End" IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}">
                                <Label Text="Inactive" Style="{StaticResource chipTextDanger}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
