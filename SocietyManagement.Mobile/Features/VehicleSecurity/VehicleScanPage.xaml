<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vs="clr-namespace:SocietyManagement.Mobile.Features.VehicleSecurity"
             x:Class="SocietyManagement.Mobile.Features.VehicleSecurity.VehicleScanPage"
             x:DataType="vs:VehicleScanViewModel"
             Title="Scan Vehicle">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="480" HorizontalOptions="Center">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Image Source="{Binding CapturedPhotoPreview}" HeightRequest="180" Aspect="AspectFit"
                           IsVisible="{Binding CapturedPhotoPath, Converter={StaticResource StringToBoolConverter}}" />
                    <Button Style="{StaticResource OutlineButton}" Text="Scan Plate (Camera)" Command="{Binding CapturePhotoCommand}" />

                    <Label Style="{StaticResource FieldLabel}" Text="Registration Number" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding RegistrationNumber}" Placeholder="e.g. MH04AB1234" /></Border>

                    <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <Button Text="Search" Command="{Binding SearchCommand}" HeightRequest="48"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding ScanResult, Converter={StaticResource IsNotNullConverter}}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ScanResult.RegistrationNumber}" FontSize="20" FontAttributes="Bold" />
                    <Border Style="{StaticResource chipSuccess}"
                           IsVisible="{Binding ScanResult.VehicleId, Converter={StaticResource IsNotNullConverter}}">
                        <Label Text="Registered" Style="{StaticResource chipTextSuccess}" />
                    </Border>
                    <Border Style="{StaticResource chipDanger}"
                           IsVisible="{Binding ScanResult.VehicleId, Converter={StaticResource IsNullConverter}}">
                        <Label Text="Not Registered" Style="{StaticResource chipTextDanger}" />
                    </Border>
                    <Label Text="{Binding ScanResult.FlatNumber, StringFormat='Flat: {0}'}"
                           IsVisible="{Binding ScanResult.FlatNumber, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Text="{Binding ScanResult.OwnerName, StringFormat='Owner: {0}'}"
                           IsVisible="{Binding ScanResult.OwnerName, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Text="{Binding ScanResult.OwnerPhone, StringFormat='Phone: {0}'}"
                           IsVisible="{Binding ScanResult.OwnerPhone, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Text="{Binding ScanResult.ParkingSlotNumber, StringFormat='Parking: {0}'}"
                           IsVisible="{Binding ScanResult.ParkingSlotNumber, Converter={StaticResource StringToBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Button Style="{StaticResource OutlineButton}" Text="Scan Another" Command="{Binding ResetCommand}"
                    IsVisible="{Binding ScanResult, Converter={StaticResource IsNotNullConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
