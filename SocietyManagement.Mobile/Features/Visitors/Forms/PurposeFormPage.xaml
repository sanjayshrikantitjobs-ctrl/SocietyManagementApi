<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Visitors.Forms"
             x:Class="SocietyManagement.Mobile.Features.Visitors.Forms.PurposeFormPage"
             x:DataType="forms:PurposeFormViewModel"
             Title="Purpose">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="Name" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding Name}" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding RequiresApproval}" />
                <Label Text="Requires Approval" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Display Order" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Entry Text="{Binding DisplayOrder}" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsEditMode}">
                <CheckBox IsChecked="{Binding IsActive}" />
                <Label Text="Active" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
