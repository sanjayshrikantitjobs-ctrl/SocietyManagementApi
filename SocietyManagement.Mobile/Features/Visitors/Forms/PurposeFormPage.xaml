<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SocietyManagement.Mobile.Features.Visitors.Forms"
             x:Class="SocietyManagement.Mobile.Features.Visitors.Forms.PurposeFormPage"
             x:DataType="forms:PurposeFormViewModel"
             Title="Purpose">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Name" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding Name}" /></Border>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding RequiresApproval}" />
                        <Label Text="Requires Approval" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource FieldLabel}" Text="Display Order" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding DisplayOrder}" Keyboard="Numeric" /></Border>

                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsEditMode}">
                        <CheckBox IsChecked="{Binding IsActive}" />
                        <Label Text="Active" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
