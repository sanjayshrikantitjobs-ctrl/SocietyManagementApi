<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:visitors="clr-namespace:SocietyManagement.Mobile.Features.Visitors"
             xmlns:gen="clr-namespace:SocietyManagement.Mobile.Api.Generated"
             x:Class="SocietyManagement.Mobile.Features.Visitors.PurposesPage"
             x:DataType="visitors:PurposesViewModel"
             x:Name="Root"
             Title="Purposes">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Grid.Row="1" Style="{StaticResource ErrorText}" Margin="16,0" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
        <Button Grid.Row="2" Margin="16,10" Text="Add Purpose" Command="{Binding AddPurposeCommand}" HorizontalOptions="Start"
                IsVisible="{Binding Auth.IsAdmin}" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Purposes}">
            <CollectionView.EmptyView>
                <Label Style="{StaticResource Muted}" Text="No visit purposes configured yet." HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="gen:VisitorPurposeDto">
                    <Border Style="{StaticResource RowCard}" Margin="14,7">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ShowPurposeActionsCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding IsActive, StringFormat='{0}'}" Style="{StaticResource Muted}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding RequiresApproval, StringFormat='Requires Approval: {0}'}" Style="{StaticResource Muted}" HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
