<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:visitors="clr-namespace:SocietyManagement.Mobile.Features.Visitors"
             x:Class="SocietyManagement.Mobile.Features.Visitors.VisitorSettingsPage"
             x:DataType="visitors:VisitorSettingsViewModel"
             Title="Visitor Settings">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource FieldLabel}" Text="Approval Request Expiry (minutes)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding ApprovalRequestExpiryMinutes}" Keyboard="Numeric" /></Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Keep Visitor History (days)" />
                    <Border Style="{StaticResource FieldFrame}"><Entry Text="{Binding RetentionDays}" Keyboard="Numeric" /></Border>
                    <Label Style="{StaticResource Muted}" Text="Visitor gate-entry records and photos older than this are automatically deleted. Default 30 days." />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Save Settings" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
