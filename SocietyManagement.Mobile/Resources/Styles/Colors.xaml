<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Society Management brand palette — sampled directly from the live web
         app's rendered screenshots (Society.zip) plus its styles.scss CSS
         vars, so the mobile app reads as the same product, not a reskin.
         Two brand colors, matching the web exactly:
           - Primary (vivid violet, #7D00FA) is Angular Material's theme
             primary (mat.$violet-palette) — it drives every solid CTA
             button, active tab underline/segment, and toggle-selected state
             on the web, so it does the same job here.
           - Info (blue, #4f6ef7) is the web's own app-primary CSS variable,
             used there for KPI icons, links, and card accents, never for
             solid buttons. Kept as a second color for exactly those jobs
             here, not merged into Primary. -->
    <Color x:Key="Primary">#7D00FA</Color>
    <Color x:Key="PrimaryDark">#5B00B8</Color>
    <Color x:Key="PrimaryLight">#EEF1FF</Color>
    <!-- Sidebar/segment "selected" text — a dark navy, not the vivid violet
         (sampled from the web sidebar's active nav item text). -->
    <Color x:Key="PrimaryDarkText">#1D1B42</Color>

    <Color x:Key="Info">#4F6EF7</Color>
    <Color x:Key="InfoDark">#3D56D6</Color>
    <Color x:Key="InfoLight">#DCE1FE</Color>

    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessLight">#DCFCE7</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningLight">#FEF3C7</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerLight">#FEE2E2</Color>
    <Color x:Key="Purple">#7D00FA</Color>
    <Color x:Key="PurpleLight">#EADEF7</Color>
    <Color x:Key="Teal">#0D9488</Color>
    <Color x:Key="TealLight">#CCFBF1</Color>

    <!-- Secondary/Tertiary kept for template compatibility (MauiProgram/App
         resources reference these keys); Secondary now points at the same
         light lavender the web uses for its own app-primary-light var. -->
    <Color x:Key="Secondary">#EEF1FF</Color>
    <Color x:Key="SecondaryDarkText">#4F6EF7</Color>
    <Color x:Key="Tertiary">#3D56D6</Color>

    <!-- Surfaces — matches web's app-surface / app-surface-alt / app-border vars -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#F6F7FB</Color>
    <Color x:Key="SurfaceAltDark">#171F2F</Color>
    <Color x:Key="BorderColor">#E5E9F0</Color>
    <Color x:Key="BorderColorDark">#2A3345</Color>

    <!-- Text — matches web's app-text / app-text-muted vars -->
    <Color x:Key="TextPrimary">#1F2937</Color>
    <Color x:Key="TextPrimaryDark">#E5E7EB</Color>
    <Color x:Key="TextMuted">#6B7280</Color>
    <Color x:Key="TextMutedDark">#9CA3AF</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#111827</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
