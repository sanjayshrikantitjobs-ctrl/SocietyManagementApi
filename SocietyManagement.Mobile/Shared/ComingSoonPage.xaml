<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocietyManagement.Mobile.Shared.ComingSoonPage"
             Title="{Binding PageTitle}">

    <VerticalStackLayout Padding="32" VerticalOptions="Center" Spacing="10">
        <Border Style="{StaticResource kpiIconBadge}" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" BackgroundColor="{StaticResource PurpleLight}">
            <Label Text="🚧" Style="{StaticResource kpiIconGlyph}" FontSize="26" />
        </Border>
        <Label Style="{StaticResource PageTitle}" Text="{Binding PageTitle}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        <Label Style="{StaticResource PageSubtitle}" Text="This module is coming soon." HorizontalOptions="Center" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>

</ContentPage>
